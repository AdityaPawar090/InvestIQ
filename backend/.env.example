# ──────────────────────────────────────────────
# InvestIQ Backend — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# Server port (Render/Railway will inject their own PORT)
PORT=3002

# MongoDB connection string
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Secret used to sign JWT tokens (use a long random string)
JWT_SECRET=change_me_to_a_long_random_string

# Comma-separated list of frontend origins allowed by CORS.
# In production, set these to your actual Vercel URLs.
CLIENT_ORIGINS=http://localhost:3000,http://localhost:3001

# Google Gemini API key (used by the AI features)
GEMINI_API_KEY=

# Set to "production" on your hosting provider
NODE_ENV=development
